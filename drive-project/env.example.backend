# GoDrive environment template

# API
GODRIVE_API_HOST=0.0.0.0
GODRIVE_API_PORT=8080
GODRIVE_API_READ_TIMEOUT=15s
GODRIVE_API_WRITE_TIMEOUT=15s
GODRIVE_API_IDLE_TIMEOUT=60s
GODRIVE_JWT_SECRET=EaeCS7TTwLrKBPS6yOq2vIO01ubd035FQgJRdja4kgY
GODRIVE_JWT_REFRESH_SECRET=gxM8yrbUo_FZWih26fHovwcVN4xtqsIfiVoJclZzQZ0B157VCspWb0Z38FrNH4uWHgoN6TnaOlbrsc52eSHXPw
GODRIVE_AUTH_ACCESS_TOKEN_TTL=15m
GODRIVE_AUTH_REFRESH_TOKEN_TTL=720h
GODRIVE_AUTH_BCRYPT_COST=12

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=godrive
POSTGRES_USER=godrive_app
POSTGRES_PASSWORD=change-me
POSTGRES_SSL_MODE=disable

# MinIO / Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=godrive
MINIO_ROOT_PASSWORD=change-me-strong-password
MINIO_BUCKET=godrive
MINIO_REGION=kz
MINIO_USE_SSL=false

# Observability
GODRIVE_METRICS_PATH=/metrics
PROMETHEUS_SCRAPE_INTERVAL=15s
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Misc
ENVIRONMENT=development
ALLOW_CORS_ORIGINS=http://localhost:3000